---
import DownloadButton from './DownloadButton.astro'
---
<section class="closing" aria-labelledby="closing-titel">
  <div class="wrap">
    <h2 id="closing-titel">Probieren Sie Mietfuchs mit Ihrer nächsten Abrechnung</h2>
    <p>Kostenlos, ohne Konto, Ihre Daten bleiben bei Ihnen.</p>
    <div class="actions">
      <DownloadButton cta="closing" />
      <a class="btn btn-ghost" href="/nebenkostenabrechnung-erstellen">Anleitung lesen</a>
    </div>
  </div>
</section>
<style>
  .closing { background: linear-gradient(135deg, #312e81, #4f46e5); color: #fff; text-align: center; padding: clamp(56px, 8vw, 96px) 0; }
  h2 { color: #fff; margin: 0 0 0.4em; }
  p { color: #e0e7ff; font-size: 1.1rem; margin: 0 0 28px; }
  .actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; }
  .closing :global(.btn-primary) { background: #fff; color: #312e81; box-shadow: none; }
  .closing :global(.btn-primary:hover) { background: #eef2ff; }
  .btn-ghost { color: #fff; border: 1px solid rgb(255 255 255 / 0.5); }
</style>
