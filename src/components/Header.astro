---
// Fester Kopf: Logo links, Menü in der Mitte, rechts Hell/Dunkel, GitHub-Abzeichen mit Sternen und
// „Herunterladen“. Die Sternzahl kommt beim Bauen von der GitHub-API (cachedStats).
import { cachedStats, formatCount } from '../lib/stats.ts'
import { REPO_URL } from '../lib/site.ts'
import Icon from './Icon.astro'

const stats = await cachedStats()
const nav = [
  { href: '/funktionen', label: 'Funktionen' },
  { href: '/ratgeber', label: 'Ratgeber' },
  { href: '/ueber', label: 'Über' },
]
---
<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href="/" aria-label="Mietfuchs, zur Startseite">
      <img src="/favicon.svg" alt="" width="32" height="32" />
      <span>Mietfuchs</span>
    </a>
    <nav aria-label="Hauptnavigation" class="main-nav">
      <ul>{nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul>
    </nav>
    <div class="tools">
      <button type="button" class="theme" data-theme-toggle hidden>
            <svg class="i-sun" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
            <svg class="i-moon" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
            <svg class="i-auto" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 3a9 9 0 0 1 0 18z" fill="currentColor"/></svg>
            <span class="visually-hidden" data-theme-label>Design: wie System</span>
          </button>
      <a class="gh" href={REPO_URL}>
        <span class="gh-name"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 16 16" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg><span>GitHub</span></span>
        <span class="gh-count"><span data-stars>{formatCount(stats.stars)}</span><span class="visually-hidden"> Sterne</span></span>
      </a>
      <a class="btn btn-primary dl" href="/herunterladen"><Icon name="download" size={18} /><span class="dl-label">Herunterladen</span></a>
    </div>
  </div>
</header>
<style>
  .site-header { position: sticky; top: 0; z-index: 20; background: var(--header-bg); backdrop-filter: saturate(1.4) blur(10px); -webkit-backdrop-filter: saturate(1.4) blur(10px); border-bottom: 1px solid var(--line); }
  .bar { display: flex; align-items: center; gap: 16px; min-height: 68px; }
  .brand { display: flex; align-items: center; gap: 10px; font-weight: 750; font-size: 1.15rem; color: var(--text); text-decoration: none; }
  .main-nav { margin: 0 auto; }
  .main-nav ul { display: flex; gap: 6px 26px; list-style: none; margin: 0; padding: 0; font-size: 0.97rem; }
  .main-nav a { color: var(--text); text-decoration: none; padding: 10px 0; display: inline-block; }
  .main-nav a:hover { color: var(--accent-text); }
  .tools { display: flex; align-items: center; gap: 10px; }
  .theme { display: inline-grid; place-items: center; width: 40px; height: 40px; border: 0; border-radius: 999px; background: transparent; color: var(--text); cursor: pointer; }
  .theme:hover { background: var(--bg-soft); }
  .theme svg { display: none; }
  .theme[data-state='system'] .i-auto, .theme[data-state='light'] .i-sun, .theme[data-state='dark'] .i-moon { display: block; }
  .gh { display: inline-flex; align-items: stretch; border: 1px solid var(--line); border-radius: 8px; overflow: hidden; color: var(--text); text-decoration: none; font-size: 0.85rem; font-weight: 600; min-height: 32px; }
  .gh-name { display: inline-flex; align-items: center; gap: 6px; padding: 0 10px; background: var(--bg-soft); }
  .gh-count { display: inline-flex; align-items: center; padding: 0 10px; border-left: 1px solid var(--line); font-variant-numeric: tabular-nums; }
  .gh:hover { border-color: var(--muted); }
  .dl { min-height: 42px; padding: 0.4em 1.2em; box-shadow: none; }
  @media (max-width: 1000px) { .main-nav { order: 3; width: 100%; margin: 0; } .bar { flex-wrap: wrap; padding-block: 8px; } .brand { margin-right: auto; } .main-nav ul { justify-content: center; } }
  @media (max-width: 560px) { .gh { display: none; } .dl { padding: 0; width: 42px; justify-content: center; } .dl-label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); } .main-nav ul { gap: 4px 18px; font-size: 0.92rem; } }
</style>
