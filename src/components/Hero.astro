---
// Kopfbereich: zentriert, große Überschrift, zwei Knöpfe, darunter die
// Eckdaten (nur echte Angaben aus getStats) und das Karussell mit Bildschirmfotos.
import DownloadButton from './DownloadButton.astro'
import BrandIcon from './BrandIcon.astro'
import ScreenCarousel from './ScreenCarousel.astro'
import { formatCount, type Stats } from '../lib/stats.ts'
import { USE_CASES } from '../data/features.ts'

interface Props { stats: Stats }
const { stats } = Astro.props
---
<section class="hero" data-section="hero">
  <div class="wrap center">
    <p class="kicker">Kostenlos und Open Source, für private Vermieter</p>
    <h1>Nebenkostenabrechnung, fertig zum Versand</h1>
    <p class="lead">Rechnungen erfassen, Zähler eintragen: Mietfuchs verteilt jede Position nach Betriebskostenverordnung und
      Heizkostenverordnung auf Ihre Mieter und erstellt je Mieter eine fertige Abrechnung zum Ausdrucken oder als PDF.
      Alles läuft auf Ihrem eigenen Rechner.</p>
    <div class="actions">
      <DownloadButton cta="primary" />
      <a class="btn btn-secondary" href="/herunterladen#docker">Auf NAS und Server</a>
    </div>
    <p class="micro systems">Für <a href="/herunterladen#windows"><BrandIcon name="windows" size={15} />Windows</a> · <a href="/herunterladen#macos"><BrandIcon name="apple" size={15} />macOS</a> · <a href="/herunterladen#linux"><BrandIcon name="linux" size={15} />Linux</a> · <a href="/herunterladen#docker"><BrandIcon name="docker" size={15} />Docker</a></p>
    <p class="micro">Ohne Konto, ohne Abo</p>
    <ul class="facts">
      <li>Kostenlos, ohne Abo</li>
      <li>Open Source (AGPL-3.0)</li>
      <li>Ihre Daten bleiben bei Ihnen</li>
      <li data-stat="downloads">{formatCount(stats.downloads)} Downloads</li>
      <li>Version {stats.version}</li>
    </ul>
    <nav class="cases" aria-labelledby="cases-title" data-use-cases>
      <p id="cases-title">Für Ihre Vermietung</p>
      <ul>{USE_CASES.map((c) => <li><a href={c.href}>{c.label}</a></li>)}</ul>
    </nav>
    <ScreenCarousel />
  </div>
</section>
<style>
  .hero { padding: clamp(40px, 7vw, 88px) 0 clamp(48px, 7vw, 80px); background: radial-gradient(900px 420px at 50% 0%, var(--accent-soft), transparent 75%); }
  .center { text-align: center; }
  h1 { max-width: 15em; margin: 0.3em auto 0.4em; font-size: clamp(1.65rem, 6.9vw, 4.4rem); hyphens: manual; }
  .lead { font-size: clamp(1.05rem, 2vw, 1.22rem); color: var(--muted); max-width: 40em; margin: 0 auto 28px; }
  .actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; }
  .micro { font-size: 0.92rem; color: var(--muted); margin: 14px 0 0; }
  .systems + .micro { margin-top: 4px; }
  .systems a { display: inline-flex; align-items: center; gap: 5px; white-space: nowrap; padding: 4px 0; }
  .systems :global(.brand-icon) { color: var(--accent-text); flex: none; }
  .facts { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px 22px; list-style: none; padding: 0; margin: 20px 0 0; font-size: 0.95rem; }
  .facts li::before { content: '✓ '; color: var(--ok); font-weight: 800; }
  .cases { margin: 28px auto 0; max-width: 52em; }
  .cases p { margin: 0 0 10px; font-weight: 600; }
  .cases ul { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; list-style: none; padding: 0; margin: 0; }
  .cases a { display: inline-block; padding: 7px 14px; border: 1px solid var(--line); border-radius: 999px; background: var(--bg); color: var(--text); text-decoration: none; font-size: 0.95rem; }
  .cases a:hover { border-color: var(--accent); color: var(--accent-text); }
</style>
