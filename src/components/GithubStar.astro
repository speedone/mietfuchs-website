---
// Stern-Knopf im Stil des GitHub-Originals, aber ohne GitHubs Skript: Die Zahl kommt beim Bauen
// von der API (cachedStats). Zugänglicher Name = sichtbarer Text plus Zusatz (WCAG 2.5.3).
import { cachedStats, formatCount } from '../lib/stats.ts'
import { REPO_URL } from '../lib/site.ts'
const stats = await cachedStats()
---
<a class="star" href={REPO_URL} data-github-stars>
  <svg aria-hidden="true" width="18" height="18" viewBox="0 0 16 16" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
  <span class="label">Star<span class="visually-hidden"> Mietfuchs auf GitHub,</span></span>
  <span class="count"><svg aria-hidden="true" width="13" height="13" viewBox="0 0 16 16" fill="currentColor"><path d="M8 .25a.75.75 0 01.67.42l1.88 3.81 4.2.61a.75.75 0 01.42 1.28l-3.04 2.96.72 4.18a.75.75 0 01-1.09.79L8 12.33l-3.76 1.97a.75.75 0 01-1.09-.79l.72-4.18L.83 6.37a.75.75 0 01.42-1.28l4.2-.61L7.33.67A.75.75 0 018 .25z"/></svg><span data-stars>{formatCount(stats.stars)}</span><span class="visually-hidden"> Sterne</span></span>
</a>
<style>
  .star { display: inline-flex; align-items: center; gap: 8px; border: 1px solid var(--line); border-radius: 8px; padding-left: 12px; min-height: 40px; font-weight: 600; font-size: 0.9rem; color: var(--text); text-decoration: none; overflow: hidden; background: var(--bg); }
  .star:hover { border-color: var(--muted); }
  .count { display: inline-flex; align-items: center; gap: 4px; align-self: stretch; padding: 0 12px; border-left: 1px solid var(--line); background: var(--bg-soft); font-variant-numeric: tabular-nums; }
  .count svg { color: #e3b341; }
</style>
