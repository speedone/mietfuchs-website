---
// Rechenweg in vier Schritten, mit den Zahlen des Abrechnungsblatts oben (StatementSheet.astro):
// Wasser 1.344,00 € × 52 / 256 m³ = 273,00 €; alle Positionen 1.885,00 € − 1.980,00 € = Guthaben 95,00 €.
const steps = [
  { title: 'Beleg', text: 'Die Rechnung für Wasser und Abwasser lautet auf 1.344,00 € für das ganze Haus. Sie hängt als PDF oder Foto an der Position.' },
  { title: 'Umlageschlüssel', text: 'Wasser wird nach Verbrauch verteilt: Alle Wohnungen zusammen haben 256 m³ verbraucht, die Wohnung 1. OG rechts 52 m³.' },
  { title: 'Anteil', text: '1.344,00 € × 52 / 256 m³ = 273,00 €. So rechnet Mietfuchs jede Position und zeigt den Weg in der Abrechnung.' },
  { title: 'Ergebnis', text: 'Alle Anteile zusammen ergeben 1.885,00 €. Abzüglich 1.980,00 € Vorauszahlungen bleibt ein Guthaben von 95,00 €.' },
]
---
<section id="rechenweg" class="wrap" aria-labelledby="rechenweg-titel">
  <p class="kicker">Nachvollziehbar</p>
  <h2 id="rechenweg-titel">Jeder Betrag mit Rechenweg</h2>
  <p class="muted lead">Mieter dürfen jede Zahl nachprüfen. Mietfuchs zeigt deshalb nicht nur das Ergebnis, sondern den Weg dorthin.</p>
  <ol class="steps">
    {steps.map((s, i) => (
      <li>
        <span class="num" aria-hidden="true">{i + 1}</span>
        <h3>{s.title}</h3>
        <p>{s.text}</p>
      </li>
    ))}
  </ol>
</section>
<style>
  .lead { max-width: 46em; }
  .steps { list-style: none; padding: 0; margin: 28px 0 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; counter-reset: s; }
  @media (max-width: 900px) { .steps { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 520px) { .steps { grid-template-columns: 1fr; } }
  .steps li { position: relative; border: 1px solid var(--line); border-radius: var(--radius); padding: 20px; background: var(--bg); }
  .num { display: inline-grid; place-items: center; width: 32px; height: 32px; border-radius: 50%; background: var(--accent-soft); color: var(--accent-text); font-weight: 750; }
  .steps h3 { margin: 12px 0 6px; }
  .steps p { margin: 0; color: var(--muted); font-size: 0.95rem; }
</style>
