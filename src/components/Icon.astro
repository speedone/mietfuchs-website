---
// Symbole aus Lucide (ISC-Lizenz, Hinweis auf /ueber#lizenzen), beim Bauen eingesetzt, nichts wird nachgeladen.
import fs from 'node:fs'
import path from 'node:path'

interface Props { name: string; size?: number; class?: string }
const { name, size = 22, class: cls } = Astro.props
const file = path.resolve('node_modules/lucide-static/icons', `${name}.svg`)
const raw = fs.readFileSync(file, 'utf8')
const svg = raw
  .replace(/<!--.*?-->/gs, '')
  .replace(/\swidth="\d+"/, ` width="${size}"`)
  .replace(/\sheight="\d+"/, ` height="${size}"`)
  .replace(/class="([^"]*)"/, (_m, c: string) => `class="${c}${cls ? ` ${cls}` : ''}"`)
  .replace('<svg', '<svg aria-hidden="true" focusable="false"')
---
<Fragment set:html={svg} />
