---
import { Image, getImage } from 'astro:assets'
import cockpit from '../assets/screens/cockpit.png'
import abrechnung from '../assets/screens/abrechnung.png'
import kosten from '../assets/screens/kosten.png'
import steuer from '../assets/screens/steuer.png'

const shots = [
  { src: cockpit, alt: 'Übersicht von Mietfuchs mit den nächsten Schritten bis zur Abrechnung', caption: 'Übersicht: was als Nächstes ansteht' },
  { src: kosten, alt: 'Kostenliste mit Umlageschlüssel je Position', caption: 'Kosten mit Umlageschlüssel und Beleg' },
  { src: abrechnung, alt: 'Abrechnung eines Mieters mit aufgeklapptem Rechenweg', caption: 'Abrechnung mit Rechenweg je Zeile' },
  { src: steuer, alt: 'Steuerübersicht mit Einnahmen und Werbungskosten für die Anlage V', caption: 'Übersicht für die Anlage V' },
]
// Große Fassung zum Vergrößern: ohne JavaScript öffnet der Link das Bild, mit JavaScript ein Dialog.
const large = await Promise.all(shots.map((s) => getImage({ src: s.src, width: 1440, format: 'webp' })))
---
<section class="wrap" data-section="screens" aria-labelledby="screens-titel">
  <p class="kicker">So sieht es aus</p>
  <h2 id="screens-titel">Ein Programm, das erklärt, was es rechnet</h2>
  <p class="muted">Zum Vergrößern auf ein Bild klicken.</p>
  <div class="shots">
    {shots.map((s, i) => (
      <figure>
        <a href={large[i]?.src} data-zoom data-alt={s.alt} aria-label={`${s.caption}: Bild vergrößern`}>
          <Image src={s.src} alt={s.alt} widths={[480, 960, 1440]} sizes="(max-width: 760px) 100vw, 540px" format="avif" loading={i < 2 ? 'eager' : 'lazy'} />
        </a>
        <figcaption>{s.caption}</figcaption>
      </figure>
    ))}
  </div>
  <dialog data-zoom-dialog aria-label="Bildschirmfoto vergrößert">
    <form method="dialog"><button class="close" aria-label="Schließen">✕</button></form>
    <img alt="" />
  </dialog>
</section>
<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-zoom-dialog]')
  const img = dialog?.querySelector('img')
  for (const a of document.querySelectorAll<HTMLAnchorElement>('[data-zoom]')) {
    a.addEventListener('click', (e) => {
      if (!dialog || !img || typeof dialog.showModal !== 'function') return
      e.preventDefault()
      img.src = a.href
      img.alt = a.dataset.alt ?? ''
      dialog.showModal()
    })
  }
  // Klick neben das Bild schließt den Dialog
  dialog?.addEventListener('click', (e) => { if (e.target === dialog) dialog.close() })
</script>
<style>
  .shots { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; margin-top: 24px; }
  @media (max-width: 760px) { .shots { grid-template-columns: 1fr; } }
  figure { margin: 0; }
  figure a { display: block; border-radius: 10px; cursor: zoom-in; }
  figure :global(img) { width: 100%; height: auto; aspect-ratio: 16 / 10; object-fit: cover; object-position: top; border-radius: 10px; border: 1px solid var(--line); box-shadow: var(--shadow); transition: transform 0.15s ease; }
  figure a:hover :global(img) { transform: scale(1.01); }
  @media (prefers-reduced-motion: reduce) { figure :global(img) { transition: none; } }
  figcaption { color: var(--muted); font-size: 0.92rem; margin-top: 10px; }
  dialog { padding: 0; border: 0; border-radius: 12px; max-width: min(96vw, 1440px); max-height: 94vh; background: var(--bg); overflow: auto; }
  dialog::backdrop { background: rgb(0 0 0 / 0.75); }
  dialog img { display: block; width: 100%; height: auto; }
  .close { position: sticky; top: 8px; float: right; margin: 8px; width: 40px; height: 40px; border-radius: 50%; border: 0; background: rgb(0 0 0 / 0.65); color: #fff; font-size: 1.1rem; cursor: pointer; }
</style>
