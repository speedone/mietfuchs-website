---
interface Props { items: { q: string; a: string }[]; title?: string }
const { items, title = 'Häufige Fragen' } = Astro.props
---
<section class="section alt" aria-labelledby="faq-titel"><div class="wrap faq">
  <div class="section-head"><h2 id="faq-titel">{title}</h2></div>
  {items.map((i) => (
    <details>
      <summary>{i.q}</summary>
      <p>{i.a}</p>
    </details>
  ))}
</div></section>
<style>
  .faq { max-width: 820px; }
  details { background: var(--bg); border: 1px solid var(--line); border-radius: 12px; padding: 4px 20px; margin-bottom: 10px; }
  summary { cursor: pointer; font-weight: 650; padding: 14px 0; list-style-position: outside; }
  details p { margin: 0 0 16px; color: var(--muted); }
</style>
