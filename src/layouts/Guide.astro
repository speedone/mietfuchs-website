---
import Base from './Base.astro'
import GuideCta from '../components/GuideCta.astro'
import PageHero from '../components/PageHero.astro'
import Sources from '../components/Sources.astro'
import { breadcrumbLd, faqLd } from '../lib/jsonld.ts'
import { SITE_URL } from '../lib/site.ts'
import type { GuideData } from '../lib/guide-schema.ts'

interface Props { data: GuideData; slug: string; headings: { depth: number; slug: string; text: string }[] }
const { data, slug, headings } = Astro.props
const path = `/${slug}`
const toc = headings.filter((h) => h.depth === 2)
const ld: object[] = [breadcrumbLd([{ name: 'Startseite', path: '/' }, { name: 'Ratgeber', path: '/ratgeber' }, { name: data.title, path }])]
if (data.faq?.length) ld.push(faqLd(data.faq))
if (data.howto) {
  ld.push({
    '@context': 'https://schema.org', '@type': 'HowTo', name: data.howto.name, inLanguage: 'de', url: `${SITE_URL}${path}`,
    step: data.howto.steps.map((text, i) => ({ '@type': 'HowToStep', position: i + 1, text })),
  })
}
---
<Base title={`${data.title} | Mietfuchs`} description={data.description} path={path} jsonLd={ld}>
  <PageHero kicker="Ratgeber für Vermieter" title={data.title} align="left">
    <nav slot="above" aria-label="Brotkrumen" class="crumbs"><a href="/">Startseite</a> › <a href="/ratgeber">Ratgeber</a> › <span aria-current="page">{data.title}</span></nav>
    <p class="stand">Stand: {data.stand} · mit Quellen aus Gesetz und Rechtsprechung</p>
  </PageHero>
  <div class="wrap layout">
    <article class="prose">
      <p class="answer">{data.answer}</p>
      <GuideCta variant="slim" />
      <slot />
      {data.faq?.length && (
        <section aria-labelledby="faq-titel" class="guide-faq"><h2 id="faq-titel">Häufige Fragen</h2>
          {data.faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
        </section>
      )}
      <GuideCta />
      <Sources sources={data.sources} stand={data.stand} />
    </article>
    {toc.length > 2 && (
      <aside class="toc" aria-label="Inhalt">
        <p>Auf dieser Seite</p>
        <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
        <a class="toc-dl" href="/herunterladen">Mietfuchs kostenlos laden</a>
      </aside>
    )}
  </div>
</Base>
<style>
  .crumbs { font-size: 0.9rem; color: var(--muted); margin-bottom: 12px; }
  .crumbs a { color: var(--muted); }
  .stand { color: var(--muted); font-size: 0.92rem; margin: 14px 0 0; }
  .layout { display: grid; grid-template-columns: minmax(0, 1fr) 260px; gap: 56px; align-items: start; padding-top: clamp(32px, 5vw, 56px); }
  @media (max-width: 1000px) { .layout { grid-template-columns: 1fr; } .toc { order: -1; position: static !important; } }
  .answer { font-size: 1.15rem; font-weight: 500; background: var(--accent-soft); border-left: 4px solid var(--indigo); padding: 16px 20px; border-radius: 0 12px 12px 0; margin-top: 0; }
  .toc { position: sticky; top: 92px; border: 1px solid var(--line); border-radius: var(--radius); padding: 18px 20px; background: var(--bg); font-size: 0.93rem; }
  .toc p { font-weight: 700; margin: 0 0 8px; }
  .toc ol { margin: 0 0 14px; padding-left: 18px; }
  .toc li { margin: 6px 0; }
  .toc a { color: var(--text); text-decoration: none; }
  .toc a:hover { color: var(--accent-text); text-decoration: underline; }
  .toc-dl { display: block; text-align: center; font-weight: 650; color: #fff !important; background: var(--indigo); border-radius: 999px; padding: 10px 14px; }
  article :global(h2) { scroll-margin-top: 92px; }
  article :global(table) { border-collapse: collapse; width: 100%; margin: 16px 0; font-size: 0.95rem; }
  article :global(th), article :global(td) { border-bottom: 1px solid var(--line); padding: 10px 12px; text-align: left; vertical-align: top; }
  article :global(thead th) { background: var(--bg-soft); }
  @media (max-width: 560px) { article :global(table) { font-size: 0.85rem; } article :global(:is(th, td)) { padding: 6px 4px; overflow-wrap: anywhere; hyphens: auto; } }
  .guide-faq details { border: 1px solid var(--line); border-radius: 12px; margin-bottom: 10px; }
  .guide-faq summary { cursor: pointer; font-weight: 650; padding: 14px 18px; list-style: none; }
  .guide-faq summary::-webkit-details-marker { display: none; }
  .guide-faq summary::after { content: ' +'; color: var(--accent-text); }
  .guide-faq details[open] summary::after { content: ' −'; }
  .guide-faq details p { margin: 0; padding: 0 18px 16px; color: var(--muted); }
</style>
