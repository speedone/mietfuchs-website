---
import { getCollection } from 'astro:content'
import Base from '../layouts/Base.astro'
import PageHero from '../components/PageHero.astro'
import ClosingBand from '../components/ClosingBand.astro'
import { breadcrumbLd } from '../lib/jsonld.ts'

const entries = (await getCollection('ratgeber')).sort((a, b) => a.data.order - b.data.order)
---
<Base
  title="Ratgeber Nebenkostenabrechnung für Vermieter | Mietfuchs"
  description="Ratgeber für private Vermieter: Nebenkostenabrechnung erstellen, Vorlage, Frist, umlagefähige Kosten, Heizkosten und Steuer, jeweils mit Quellen."
  path="/ratgeber"
  jsonLd={[breadcrumbLd([{ name: 'Startseite', path: '/' }, { name: 'Ratgeber', path: '/ratgeber' }])]}
>
  <PageHero kicker="Ratgeber" title="Ratgeber zur Nebenkostenabrechnung" lead="Für private Vermieter: verständlich erklärt und mit Quellen aus Gesetz und Rechtsprechung belegt." />
  <section class="section alt">
    <div class="wrap">
      <ul class="list">
        {entries.map((e) => (
          <li><a href={`/${e.id}`}><h2>{e.data.title}</h2><p>{e.data.answer}</p><span class="go">Weiterlesen</span></a></li>
        ))}
      </ul>
    </div>
  </section>
  <ClosingBand />
</Base>
<style>
  .list { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr)); gap: 18px; }
  .list a { display: flex; flex-direction: column; height: 100%; background: var(--bg); border: 1px solid var(--line); border-radius: var(--radius); padding: 24px; color: var(--text); text-decoration: none; transition: border-color 0.15s; }
  .list a:hover { border-color: var(--indigo); }
  .list h2 { font-size: 1.25rem; margin: 0 0 10px; }
  .list p { margin: 0 0 14px; color: var(--muted); flex: 1; }
  .go { color: var(--accent-text); font-weight: 650; }
  @media (prefers-reduced-motion: reduce) { .list a { transition: none; } }
</style>
