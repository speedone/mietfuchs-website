---
import Base from '../layouts/Base.astro'
import PageHero from '../components/PageHero.astro'
import DownloadButton from '../components/DownloadButton.astro'
import ClosingBand from '../components/ClosingBand.astro'
import Icon from '../components/Icon.astro'
import { breadcrumbLd } from '../lib/jsonld.ts'
import { FEATURE_GROUPS as groups } from '../data/features.ts'
---
<Base
  title="Funktionen: Nebenkostenabrechnung mit Mietfuchs"
  description="Was Mietfuchs kann: centgenaue Verteilung, Heizkostenabrechnung nach HeizkostenV, mehrere Häuser, Mietkonto, Anlage V, Belege und Hinweise mit Rechtsgrundlage."
  path="/funktionen"
  jsonLd={[breadcrumbLd([{ name: 'Startseite', path: '/' }, { name: 'Funktionen', path: '/funktionen' }])]}
>
  <PageHero kicker="Funktionen" title="Was Mietfuchs für Ihre Nebenkostenabrechnung tut" lead="Für private Vermieter gemacht: vom Haus mit Einliegerwohnung bis zu mehreren Mehrfamilienhäusern, kostenlos und auf Ihrem eigenen Rechner.">
    <div class="actions"><DownloadButton cta="funktionen" /><a class="btn btn-secondary" href="/nebenkostenabrechnung-erstellen">So erstellen Sie die Abrechnung</a></div>
  </PageHero>
  {groups.map((g, gi) => (
    <section id={g.id} class:list={['section', { alt: gi % 2 === 1 }]} aria-labelledby={`${g.id}-titel`}>
      <div class="wrap">
        <div class="section-head"><h2 id={`${g.id}-titel`}>{g.title}</h2><p>{g.lead}</p></div>
        <ul class="cards">
          {g.items.map((f) => <li><span class="ic"><Icon name={f.icon} /></span><h3>{f.title}</h3><p>{f.text}</p></li>)}
        </ul>
      </div>
    </section>
  ))}
  <ClosingBand />
</Base>
<style>
  .cards { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr)); gap: 18px; }
  .cards li { background: var(--bg); border: 1px solid var(--line); border-radius: var(--radius); padding: 22px 24px; }
  .cards h3 { margin: 12px 0 8px; }
  .ic { display: inline-grid; place-items: center; width: 44px; height: 44px; border-radius: 12px; background: var(--accent-soft); color: var(--accent-text); }
  .cards p { margin: 0; color: var(--muted); }
</style>
