---
import Base from '../layouts/Base.astro'
import { CONTACT_EMAIL, REPO_URL } from '../lib/site.ts'
---
<Base title="Kontakt | Mietfuchs" description="Kontakt zum Projekt Mietfuchs: Fragen, Hinweise und Wünsche per Formular oder E-Mail." path="/kontakt">
  <div class="wrap prose">
    <h1>Kontakt</h1>
    <p>Fragen, Hinweise oder Wünsche zu Mietfuchs? Schreiben Sie uns über das Formular oder an
      <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>. Fehler im Programm melden Sie am besten als
      <a href={`${REPO_URL}/issues`}>Issue auf GitHub</a>; dort sehen auch andere Nutzer die Antwort.</p>
    <p class="muted">Bitte beachten Sie: Wir können keine Rechtsberatung zu Ihrer Abrechnung geben.</p>
    <form method="post" action="/api/kontakt" class="contact" data-contact-form>
      <label for="name">Name</label>
      <input id="name" name="name" required maxlength="100" autocomplete="name" />
      <label for="email">E-Mail-Adresse</label>
      <input id="email" name="email" type="email" required maxlength="200" autocomplete="email" />
      <label for="message">Nachricht</label>
      <textarea id="message" name="message" required minlength="10" maxlength="5000" rows="7"></textarea>
      <div class="hp" aria-hidden="true">
        <label for="website">Website (bitte leer lassen)</label>
        <input id="website" name="website" tabindex="-1" autocomplete="off" />
      </div>
      <input type="hidden" name="t" value="" />
      <button class="btn btn-primary" type="submit">Nachricht senden</button>
      <p class="muted small">Ihre Angaben verwenden wir nur, um Ihre Nachricht zu beantworten. Mehr dazu in der
        <a href="/datenschutz">Datenschutzerklärung</a>.</p>
    </form>
  </div>
</Base>
<script>
  const t = document.querySelector<HTMLInputElement>('[data-contact-form] input[name=t]')
  if (t) t.value = String(Date.now())
</script>
<style>
  .contact { margin-top: 24px; }
  label { display: block; font-weight: 600; margin-top: 16px; }
  input, textarea { width: 100%; font: inherit; color: var(--text); background: var(--bg); padding: 10px 12px; border: 1px solid var(--muted); border-radius: 8px; }
  button { margin-top: 20px; border: 0; cursor: pointer; font: inherit; font-weight: 650; }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .small { font-size: 0.9rem; margin-top: 12px; }
</style>
