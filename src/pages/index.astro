---
import Base from '../layouts/Base.astro'
import Hero from '../components/Hero.astro'
import PreSendChecks from '../components/PreSendChecks.astro'
import Features from '../components/Features.astro'
import HowItAdds from '../components/HowItAdds.astro'
import ForWhom from '../components/ForWhom.astro'
import ExcelCompare from '../components/ExcelCompare.astro'
import SelfHost from '../components/SelfHost.astro'
import Faq from '../components/Faq.astro'
import ClosingBand from '../components/ClosingBand.astro'
import SupportSection from '../components/SupportSection.astro'
import { cachedStats as getStats } from '../lib/stats.ts'
import { faqLd, softwareAppLd } from '../lib/jsonld.ts'
import { HOME_FAQ } from '../data/home-faq.ts'

const stats = await getStats()
---
<Base
  title="Nebenkostenabrechnung Programm kostenlos | Mietfuchs"
  description="Kostenloses Programm für die Nebenkostenabrechnung privater Vermieter: fertige Abrechnung je Mieter mit Rechenweg, lokal auf Ihrem Rechner."
  path="/"
  jsonLd={[softwareAppLd(stats), faqLd(HOME_FAQ)]}
>
  <Hero stats={stats} />
  <HowItAdds />
  <ForWhom />
  <PreSendChecks />
  <Features />
  <ExcelCompare />
  <SelfHost />
  <SupportSection />
  <Faq items={HOME_FAQ} alt={false} />
  <ClosingBand />
</Base>
